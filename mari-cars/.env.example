# Copy to .env (never commit .env). Values below are local-development placeholders only.
NODE_ENV=development

# API
PORT=4000
MONGODB_URI=mongodb://localhost:27017/marycars?replicaSet=rs0&directConnection=true
WEB_ORIGIN=http://localhost:3000
JWT_ACCESS_SECRET=change-me-min-32-chars-long-xxxxxxxx
JWT_REFRESH_SECRET=change-me-min-32-chars-long-yyyyyyyy

# Image storage: local disk now, s3 later
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
PUBLIC_MEDIA_URL=http://localhost:4000/media

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
